SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# One-time owner migration only. Keep the direct database URL out of Git and logs.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Server-only. Never expose this key to the browser or client configuration.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Server and cron-provider secret for POST/GET /api/cron/daily-sync. Keep it out of Git and logs.
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Global Brickset price-cache freshness in hours (integer 0-8760; 0 disables reuse, default 24).
DAILY_SYNC_PRICE_CACHE_TTL_HOURS=24