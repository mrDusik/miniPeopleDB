                        $("body").on("click", "#realDownloadUrl a", function () {
                            $('#count_num').html(0);
                            clearInterval(timer);
                        });
                    });</script> <div class="similar-fonts"><h3 class="you-may-like-down text-center row-space">More Awesome Similar Free Fonts</h3><div class="download-related-posts"><ul class="list-unstyled fonts-list row font-family__list"><li class="col-12 col-md-6 col-sm-12 col-xs-12"><div data-id="796369" class="post-796369 post type-post status-publish format-standard category-display-fonts category-sans-serif-fonts designer-saeful-maarif font_family-koberon entry clearfix hocwp-post author-doraemon"><div class="font-item card-font"> <a href="https://exfont.com/koberon-black-otf.font"
 title="Koberon-Black (Saeful Maarif)" class="font-item__link"><div class="font-item__title"> <strong>Koberon-Black</strong> - Saeful Maarif</div><div class="font-item__body"><div class="font-preview font-preview-phrase-md font-item__preview"><div class="font-preview-text"
 data-script-name="Koberon-Black"
 data-font="Koberon-Black"
 data-font-family="Koberon-Black-Exfont796369"
 data-font-url="https://exfont.com/wp-content/uploads/2026/09/Koberon-Black-Exfonte591.otf"
 data-font-format="opentype"> Koberon-Black</div></div> <script>(function () {
		'use strict';

		var SELECTOR =
			'.card-font .font-item__preview .font-preview-text';

		var BASE_SIZE  = 85;
		var MAX_HEIGHT = 110;
		var MIN_SIZE   = 20;


		/*
		 * Đo trực tiếp element thật.
		 *
		 * Không tạo hidden probe.
		 */
		function measureHeight(element, fontSize) {

			element.style.setProperty(
				'font-size',
				fontSize + 'px',
				'important'
			);

			element.style.setProperty(
				'transform',
				'none',
				'important'
			);

			return element.getBoundingClientRect().height;
		}


		function fitFont(element) {

			/*
			 * Một card chỉ xử lý một lần.
			 */
			if (
				element.getAttribute(
					'data-bf-height-fitted'
				) === '1'
			) {
				return;
			}


			var text =
				(element.textContent || '')
					.replace(/\s+/g, ' ')
					.trim();

			if (!text) {
				return;
			}


			/*
			 * Bắt đầu ở 85px.
			 */
			var fontSize = BASE_SIZE;

			var height =
				measureHeight(
					element,
					fontSize
				);


			/*
			 * Chỉ giảm font khi chiều cao vượt 110px.
			 */
			if (
				height > MAX_HEIGHT &&
				height > 0 &&
				isFinite(height)
			) {

				/*
				 * Tính gần đúng ngay lần đầu.
				 *
				 * Ví dụ:
				 * 85px → cao 135px
				 *
				 * 85 × 110 / 135 ≈ 69px
				 */
				fontSize =
					Math.floor(
						BASE_SIZE *
						(
							MAX_HEIGHT /
							height
						)
					);


				fontSize =
					Math.max(
						MIN_SIZE,
						Math.min(
							BASE_SIZE,
							fontSize
						)
					);


				height =
					measureHeight(
						element,
						fontSize
					);


				/*
				 * Tối đa 3 lần hiệu chỉnh.
				 *
				 * Thay vì while giảm từng 1px
				 * có thể gây nhiều layout/reflow.
				 */
				var attempts = 0;

				while (
					height > MAX_HEIGHT &&
					fontSize > MIN_SIZE &&
					attempts < 3
				) {

					var nextSize =
						Math.floor(
							fontSize *
							(
								MAX_HEIGHT /
								height
							)
						);


					/*
					 * Tránh trường hợp làm tròn
					 * vẫn ra cùng một font-size.
					 */
					if (nextSize >= fontSize) {
						nextSize = fontSize - 1;
					}


					fontSize =
						Math.max(
							MIN_SIZE,
							nextSize
						);


					height =
						measureHeight(
							element,
							fontSize
						);


					attempts++;
				}
			}


			/*
			 * Áp dụng kết quả cuối.
			 */
			element.style.setProperty(
				'font-size',
				fontSize + 'px',
				'important'
			);

			element.style.setProperty(
				'transform',
				'none',
				'important'
			);


			element.setAttribute(
				'data-bf-height-fitted',
				'1'
			);


			/*
			 * Hai attribute dưới chỉ dùng để debug.
			 * Không ảnh hưởng giao diện.
			 */
			element.setAttribute(
				'data-bf-font-size',
				fontSize
			);

			element.setAttribute(
				'data-bf-render-height',
				height.toFixed(2)
			);
		}


		/*
		 * Sau khi Exfont đã gắn custom font,
		 * đảm bảo font thực sự tải xong trước khi đo.
		 */
		function runWhenFontReady(element) {

			var text =
				(element.textContent || '')
					.replace(/\s+/g, ' ')
					.trim();


			if (!text) {
				return;
			}


			function run() {

				window.requestAnimationFrame(
					function () {
						fitFont(element);
					}
				);
			}


			/*
			 * Font Loading API.
			 *
			 * Tránh trường hợp class font-updated đã có
			 * nhưng file font chưa decode/render xong.
			 */
			if (
				document.fonts &&
				document.fonts.load
			) {

				var style =
					window.getComputedStyle(
						element
					);


				var fontDefinition =
					style.fontStyle + ' ' +
					style.fontWeight + ' ' +
					BASE_SIZE + 'px ' +
					style.fontFamily;


				document.fonts
					.load(
						fontDefinition,
						text
					)
					.then(run)
					.catch(run);

			} else {

				run();
			}
		}


		function prepare(element) {

			if (
				element.getAttribute(
					'data-bf-height-started'
				) === '1'
			) {
				return;
			}


			element.setAttribute(
				'data-bf-height-started',
				'1'
			);


			/*
			 * Font đã được JS Exfont xử lý.
			 */
			if (
				element.classList.contains(
					'font-updated'
				)
			) {

				runWhenFontReady(element);

				return;
			}


			var finished = false;


			var observer =
				new MutationObserver(
					function () {

						if (finished) {
							return;
						}


						if (
							!element.classList.contains(
								'font-updated'
							)
						) {
							return;
						}


						finished = true;

						observer.disconnect();


						runWhenFontReady(
							element
						);
					}
				);


			observer.observe(
				element,
				{
					attributes: true,

					/*
					 * Chỉ cần quan sát class.
					 *
					 * Code cũ còn quan sát style,
					 * không cần thiết.
					 */
					attributeFilter: [
						'class'
					]
				}
			);


			/*
			 * Fallback.
			 */
			window.setTimeout(
				function () {

					if (finished) {
						return;
					}


					finished = true;

					observer.disconnect();


					runWhenFontReady(
						element
					);

				},
				2500
			);
		}


		function init() {

			var elements =
				document.querySelectorAll(
					SELECTOR
				);


			if (!elements.length) {
				return;
			}


			/*
			 * Font ngoài viewport chưa cần xử lý.
			 */
			if (
				'IntersectionObserver' in window
			) {

				var viewportObserver =
					new IntersectionObserver(
						function (entries) {

							entries.forEach(
								function (entry) {

									if (
										!entry.isIntersecting
									) {
										return;
									}


									prepare(
										entry.target
									);


									viewportObserver.unobserve(
										entry.target
									);
								}
							);

						},
						{
							rootMargin:
								'300px 0px',

							threshold: 0
						}
					);


				elements.forEach(
					function (element) {

						viewportObserver.observe(
							element
						);

					}
				);

			} else {

				elements.forEach(
					function (element) {

						prepare(
							element
						);

					}
				);
			}
		}


		if (
			document.readyState ===
			'loading'
		) {

			document.addEventListener(
				'DOMContentLoaded',
				init,
				{
					once: true
				}
			);

		} else {

			init();
		}

	})();</script> </div> </a><div class="font-item__controls"><div class="font-item__glyphs"> <span>234 glyphs</span></div> <a href="#" class="font-item__fav btn-add-collection fav-btn" data-title="Koberon-Black"
